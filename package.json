{
  "name": "sunset-and-silence-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run --workspaces --if-present build",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:case": "npm run --workspace=@sunset/case-engine generate:case",
    "cli": "npm run --workspace=@sunset/case-engine start:cli",
    "lint": "eslint ."
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
